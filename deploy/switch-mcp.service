# Optional: run the MCP server as a service instead of deploy/run-with-caps.
# Replace USER and PROJECT_DIR, copy to /etc/systemd/system/, then:
#   sudo systemctl daemon-reload && sudo systemctl start switch-mcp
[Unit]
Description=Nintendo Switch MCP server
After=bluetooth.service
Requires=bluetooth.service

[Service]
User=USER
WorkingDirectory=PROJECT_DIR
ExecStart=PROJECT_DIR/.venv/bin/switch-mcp --transport streamable-http
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
