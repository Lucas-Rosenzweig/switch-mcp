# Generated by install.sh from deploy/switch-mcp.service.in; rerun it to update.
#
# Not enabled at boot: `switch-mcp start` and `switch-mcp stop` drive it, and a
# polkit rule lets @USER@ do so without a password. While it runs, bluetoothd
# is in controller emulation mode; stopping it brings normal Bluetooth back.
[Unit]
Description=Nintendo Switch MCP server (emulated controller and HDMI capture)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=exec
User=@USER@
WorkingDirectory=@PROJECT@
Environment=PYTHONUNBUFFERED=1
# "+": these two run as root, outside the restrictions below.
ExecStartPre=+@HELPER@ on
ExecStart=@PROJECT@/.venv/bin/switch-mcp serve --transport streamable-http --reload-file @PROJECT@/.reload
ExecStopPost=+@HELPER@ off
# Bluetooth emulation needs raw HCI sockets, the kernel's management
# interface, and the HID L2CAP ports below 4097.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=2
# `touch .reload` in the project restarts the server with the current code.
RestartForceExitStatus=75
