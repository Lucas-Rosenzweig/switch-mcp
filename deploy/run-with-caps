#!/usr/bin/env bash
# Run the MCP server in the foreground as the current user, with only the
# three network capabilities Bluetooth emulation needs (no root, no setcap
# on the Python interpreter). Stop it with Ctrl+C.
#
# While developing, `touch .reload` in the project restarts the server with
# the current code, without going through sudo again.
set -euo pipefail

project=$(cd "$(dirname "$0")/.." && pwd)

exec sudo systemd-run --pty --collect --quiet \
    --unit=switch-mcp-session \
    --property=User="$(id -un)" \
    --property=AmbientCapabilities="CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE" \
    --property=WorkingDirectory="$project" \
    --setenv=HOME="$HOME" \
    --setenv=SWITCH_MCP_BACKEND="${SWITCH_MCP_BACKEND:-nuxbt}" \
    --setenv=SWITCH_MCP_VIDEO_DEVICE="${SWITCH_MCP_VIDEO_DEVICE:-/dev/video0}" \
    --setenv=SWITCH_MCP_PORT="${SWITCH_MCP_PORT:-8765}" \
    --setenv=SWITCH_MCP_NUXBT_DEBUG="${SWITCH_MCP_NUXBT_DEBUG:-0}" \
    /bin/sh -c 'while :; do "$0/.venv/bin/switch-mcp" --transport streamable-http --reload-file "$0/.reload"; [ $? -eq 75 ] || break; echo "--- restarting ---"; done' "$project"
